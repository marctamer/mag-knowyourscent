            const scores = {};
            MAG_PERFUMES.forEach(p => scores[p.id] = 0);

            userAnswers.forEach((ansIdx, qIdx) => {
                const opt = QUIZ_QUESTIONS[qIdx].options[ansIdx];
                if (opt && opt.weights) {
                    for (const [id, weight] of Object.entries(opt.weights)) {
                        scores[id] = (scores[id] || 0) + weight;
                    }
                }
            });

            const sorted = Object.keys(scores).map(id => ({
                id,
                score: scores[id],
                perfume: MAG_PERFUMES.find(p => p.id === id)
            })).sort((a, b) => b.score - a.score);

            // Trigger Loading Screen
            navTo('loading');

            const statusTexts = [
                "Analyzing Olfactory Pyramid...",
                "Distilling Accords & Sillage...",
                "Harmonizing Scent Signature..."
            ];
            let sIdx = 0;
            const interval = setInterval(() => {
                sIdx = (sIdx + 1) % statusTexts.length;
                document.getElementById('loading-status-text').innerText = statusTexts[sIdx];
            }, 500);

            setTimeout(() => {
                clearInterval(interval);
                displayResults(sorted);
            }, 1600);
        }

