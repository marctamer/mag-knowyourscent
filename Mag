        function displayResults(sortedResults) {
            const topMatch = sortedResults[0].perfume;
            const secondMatch = sortedResults[1].perfume;
            const thirdMatch = sortedResults[2].perfume;

            currentMatchResult = topMatch;
            navTo('result');

            document.getElementById('res-header-name').innerText = topMatch.name;
            document.getElementById('res-title').innerText = topMatch.name;
            document.getElementById('res-category-tag').innerText = `${topMatch.category} Formulation`;
            document.getElementById('res-description').innerText = topMatch.description;
            document.getElementById('res-badge').innerText = topMatch.subCategory;

            document.getElementById('res-notes-top').innerText = topMatch.topNotes;
            document.getElementById('res-notes-heart').innerText = topMatch.heartNotes;
            document.getElementById('res-notes-base').innerText = topMatch.baseNotes;

            document.getElementById('res-setting').innerText = topMatch.setting;
            document.getElementById('res-projection').innerText = topMatch.projection;
            document.getElementById('res-bottle-sub').innerText = topMatch.name;

            // Tailored narrative based on first answer
            const firstChoiceLabel = QUIZ_QUESTIONS[0].options[userAnswers[0]].label.toLowerCase();
            document.getElementById('res-why-narrative').innerText = 
                `Based on your preference for ${firstChoiceLabel}, ${topMatch.name} offers the ideal MAG formulation. Featuring ${topMatch.topNotes.toLowerCase()} leading into ${topMatch.baseNotes.toLowerCase()}, it embodies a ${topMatch.vibe.toLowerCase()} presence.`;

            // Runner Ups
            const runnerContainer = document.getElementById('res-runner-ups');
            runnerContainer.innerHTML = '';
            
            [secondMatch, thirdMatch].forEach(runner => {
                const card = document.createElement('div');
                card.className = "glass-panel p-4 rounded-2xl border border-white/10 hover:border-gold-400/40 transition-all cursor-pointer flex items-center justify-between";
                card.onclick = () => openDetailModal(runner.id);

                card.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-xl bg-gold-400/10 border border-gold-400/30 flex items-center justify-center text-gold-300 font-serif font-bold text-xs">
                            MAG
                        </div>
                        <div>
                            <h5 class="text-sm font-semibold text-white">${runner.name}</h5>
                            <p class="text-[11px] text-gray-400 mt-0.5">${runner.category}</p>
                        </div>
                    </div>
                    <span class="text-[10px] uppercase font-bold tracking-wider text-gold-400 bg-gold-400/10 px-3 py-1 rounded-full border border-gold-400/20">
                        View Scent
                    </span>
                `;
                runnerContainer.appendChild(card);
            });
        }

        // ================= 7. CATALOG RENDER =================
        function filterCatalog(catKey) {
            const btns = document.querySelectorAll('#catalog-category-filters button');
            btns.forEach(b => {
                b.className = "cat-filter-btn text-xs px-4 py-1.5 rounded-full border border-white/10 text-gray-400 hover:text-white";
            });
            event.target.className = "cat-filter-btn active text-xs px-4 py-1.5 rounded-full border border-gold-400 bg-gold-400/20 text-gold-300 font-medium";

            renderCatalog(catKey);
        }

        function renderCatalog(filterKey) {
            const grid = document.getElementById('catalog-grid');
            grid.innerHTML = '';

            const list = (filterKey === 'all') 
                ? MAG_PERFUMES 
                : MAG_PERFUMES.filter(p => p.category.toLowerCase().includes(filterKey.toLowerCase()) || p.description.toLowerCase().includes(filterKey.toLowerCase()));

            list.forEach(item => {
                const card = document.createElement('div');
                card.className = "glass-panel p-5 rounded-2xl border border-white/10 hover:border-gold-400/40 transition-all flex flex-col justify-between group cursor-pointer";
                card.onclick = () => openDetailModal(item.id);

                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[9px] uppercase tracking-widest text-gold-400 bg-gold-400/10 px-2.5 py-0.5 rounded-full border border-gold-400/20">${item.category}</span>
                            <span class="text-[10px] text-gray-400 font-mono">EST. 2025</span>
                        </div>
                        <h4 class="font-serif text-2xl font-bold text-white group-hover:text-gold-300 transition-colors">${item.name}</h4>
                        <p class="text-xs text-gray-300 mt-2 line-clamp-2 leading-relaxed font-light">${item.description}</p>
                    </div>
                    
                    <div class="mt-4 pt-3 border-t border-white/10 space-y-2">
                        <div class="text-[11px] text-gray-400">
                            <strong class="text-gold-400 font-normal">Notes:</strong> ${item.topNotes} → ${item.baseNotes}
                        </div>
                        <div class="flex items-center justify-between text-xs pt-1">
                            <span class="text-gray-400 text-[10px] uppercase tracking-wider">${item.subCategory}</span>
                            <span class="text-gold-300 font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 text-[11px]">
                                Details →
                            </span>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // ================= 8. SINGLE PERFUME DETAIL MODAL =================
        function openDetailModal(id) {
            const p = MAG_PERFUMES.find(item => item.id === id);
            if (!p) return;

            const content = document.getElementById('modal-detail-content');
            content.innerHTML = `
                <div class="w-12 h-12 rounded-full bg-gold-400/10 border border-gold-400/40 flex items-center justify-center text-gold-300 font-serif text-xl font-bold mx-auto mb-3">
                    MAG
                </div>
                <span class="text-[9px] uppercase tracking-[0.2em] font-bold text-gold-400 bg-gold-400/10 px-3 py-1 rounded-full border border-gold-400/20">
                    ${p.category} Formulation
                </span>
                <h3 class="font-serif text-3xl font-bold text-white mt-3 gold-gradient-text">${p.name}</h3>
                
                <p class="text-xs text-gray-300 mt-3 leading-relaxed font-light">${p.description}</p>

                <!-- Full Notes Pyramid -->
                <div class="my-5 p-4 rounded-2xl bg-obsidian-950 border border-white/10 text-left space-y-3 text-xs">
